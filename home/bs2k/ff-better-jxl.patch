-void PrintCache(const Cache& c, size_t level) {
-  fprintf(stderr,
-          "L%zu: size %u KiB, line size %u, assoc %u, sets %u, cores %u\n",
-          level, c.size_kib, c.bytes_per_line, c.associativity, c.sets,
-          c.cores_sharing);
