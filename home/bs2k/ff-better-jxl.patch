-// ------------------------------ CompressBitsStore
-template <class D, HWY_IF_NOT_T_SIZE_D(D, 1)>
-HWY_API size_t CompressBitsStore(VFromD<D> v, const uint8_t* HWY_RESTRICT bits,
-                                 D d, TFromD<D>* HWY_RESTRICT unaligned) {
-  const MFromD<D> mask = LoadMaskBits(d, bits);
