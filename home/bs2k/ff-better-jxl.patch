-template <class D>
-std::vector<size_t> Counts(D d) {
-  const size_t N = Lanes(d);
-  return std::vector<size_t>{1,
-                             3,
-                             7,
-                             16,
-                             HWY_MAX(N / 2, 1),
-                             HWY_MAX(2 * N / 3, 1),
-                             N,
-                             N + 1,
-                             4 * N / 3,
-                             3 * N,
-                             8 * N,
-                             8 * N + 2,
-                             256 * N - 1,
-                             256 * N};
-}
