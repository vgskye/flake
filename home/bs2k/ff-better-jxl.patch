-  static HWY_INLINE void Wait() {
-#if HWY_ENABLE_SPIN_ASM
-    asm volatile("umwait %%ecx" ::"c"(kControl), "d"(kDeadline >> 32),
-                 "a"(kDeadline & 0xFFFFFFFFu));
-#else
-    _umwait(kControl, kDeadline);
-#endif
