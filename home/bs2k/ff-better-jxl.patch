-HWY_API VFromD<D> ResizeBitCast(D d, FromV v) {
-  const Repartition<uint8_t, decltype(d)> du8_to;
-  return BitCast(d, VFromD<decltype(du8_to)>{detail::BitCastToInteger(v.raw)});
-}
