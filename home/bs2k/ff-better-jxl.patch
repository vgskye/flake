+        &self,
+        position: (usize, usize),
+        xsize: usize,
+        row: &mut [&mut [f32]],
+        _state: Option<&mut dyn std::any::Any>,
+    ) {
+        self.splines.draw_segments(row, position, xsize);
+    }
