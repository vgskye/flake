- private:
-  static HWY_INLINE void Monitor(const void* addr) {
-#if HWY_ENABLE_SPIN_ASM
-    asm volatile("umonitor %%rcx" ::"c"(addr));
-#else
-    _umonitor(const_cast<void*>(addr));
-#endif
-  }
