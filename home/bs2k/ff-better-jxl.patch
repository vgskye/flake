-template <size_t kIdx3210, class V>
-HWY_INLINE V Per4LaneBlockShuffle(hwy::SizeTag<kIdx3210> /*idx_3210_tag*/,
-                                  hwy::SizeTag<4> /*lane_size_tag*/,
-                                  hwy::SizeTag<32> /*vect_size_tag*/, V v) {
