-          static_cast<uint32_t>(profiler.GetFirstDurationAndReset(global_idx));
-    }
-    samples[idx_sample] = robust_statistics::Mode(durations, kNumDurations);
-  }
-  return robust_statistics::Mode(samples, kNumSamples);
-}
