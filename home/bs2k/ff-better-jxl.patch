-struct BitCastScalarSrcCastHelper<hwy::bfloat16_t> {
-#if HWY_HAVE_SCALAR_BF16_TYPE
-  static HWY_INLINE constexpr const hwy::bfloat16_t::Native& CastSrcValRef(
-      const hwy::bfloat16_t& val) {
-    return val.native;
