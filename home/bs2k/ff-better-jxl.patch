-// Shifting and adding requires fewer instructions than blending, but casting to
-// u64 does not work for LMUL < 1.
-template <class D, HWY_IF_T_SIZE_D(D, 4)>
-HWY_API VFromD<D> Reverse2(D d, const VFromD<D> v) {
