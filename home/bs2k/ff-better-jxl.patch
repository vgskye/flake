-
-template <typename D, HWY_IF_V_SIZE_D(D, 32), HWY_IF_T_SIZE_D(D, 2)>
-HWY_API VFromD<D> Slide1Down(D d, VFromD<D> v) {
-  const Half<decltype(d)> dh;
-  const auto v_hi = ZeroExtendVector(d, UpperHalf(dh, v));
