-static HWY_INLINE size_t VsxCntlzLsbb(V v) {
-#if HWY_COMPILER_GCC_ACTUAL && HWY_COMPILER_GCC_ACTUAL < 1200 && \
-    HWY_IS_LITTLE_ENDIAN
