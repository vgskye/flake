-// Without a native OddEven, it seems infeasible to go faster than Lt128.
-template <class D>
-HWY_INLINE VFromD<D> Min128(D d, const VFromD<D> a, const VFromD<D> b) {
-  return IfThenElse(Lt128(d, a, b), a, b);
