-  const Sisd<TU> du;
-  return BitCast(Sisd<T>(), Vec1<TU>(BitCast(du, a).raw & BitCast(du, b).raw));
-}
-template <typename T>
-HWY_API Vec1<T> operator&(const Vec1<T> a, const Vec1<T> b) {
