-template <class D>
-HWY_API void BlendedStore(VFromD<D> v, MFromD<D> m, D d,
-                          TFromD<D>* HWY_RESTRICT p) {
-  for (size_t i = 0; i < MaxLanes(d); ++i) {
-    if (m.bits[i]) p[i] = v.raw[i];
-  }
