-// ------------------------------ FirstN (Iota, Lt)
-
-template <class D>
-HWY_API MFromD<D> FirstN(D d, size_t num) {
-  const RebindToSigned<decltype(d)> di;  // Signed comparisons are cheaper.
-  using TI = TFromD<decltype(di)>;
-  return RebindMask(d, detail::Iota0(di) < Set(di, static_cast<TI>(num)));
-}
