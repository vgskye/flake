+fn avfidct4x4(coeffs: &[f32], pixels: &mut [f32]) {
+    for i in 0..16 {
+        let mut pixel: f32 = 0.0;
+        for j in 0..16 {
+            pixel += coeffs[j] * AFV4X4BASIS[j * 16 + i];
+        }
+        pixels[i] = pixel;
+    }
+}
