-// 64 or 128-bit input: extract from concatenated
-template <class D, HWY_IF_V_SIZE_GT_D(D, 4)>
-HWY_API VFromD<D> ConcatLowerUpper(D d, VFromD<D> hi, VFromD<D> lo) {
-  return CombineShiftRightBytes<d.MaxBytes() / 2>(d, hi, lo);
-}
