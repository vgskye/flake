-// ------------------------------ Expand
-template <typename T>
-HWY_API Vec256<T> Expand(const Vec256<T> v, const Mask256<T> mask) {
-  Vec256<T> ret;
-  const Full256<T> d;
-  const Half<decltype(d)> dh;
-  alignas(32) T lanes[32 / sizeof(T)] = {};
-  Store(v, d, lanes);
-  ret.v0 = Expand(v.v0, mask.m0);
-  ret.v1 = Expand(LoadU(dh, lanes + CountTrue(dh, mask.m0)), mask.m1);
-  return ret;
