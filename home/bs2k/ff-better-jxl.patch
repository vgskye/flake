-HWY_API void SafeFillN(const size_t num, const T value, D d,
-                       T* HWY_RESTRICT to) {
-#if HWY_MEM_OPS_MIGHT_FAULT
-  (void)d;
-  for (size_t i = 0; i < num; ++i) {
-    to[i] = value;
-  }
-#else
-  BlendedStore(Set(d, value), FirstN(d, num), d, to);
