-template <class D, class V = VFromD<D>, HWY_IF_T_SIZE_D(D, 8)>
-HWY_API V Reverse2(D /* tag */, const V v) {
-  const V up = detail::Slide1Up(v);
-  const V down = detail::Slide1Down(v);
