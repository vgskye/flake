-                        V& s, V& c) {
-  using T = TFromD<D>;
-  using TI = MakeSigned<T>;
-  using DI = Rebind<TI, D>;
-  const DI di;
-  using VI = decltype(Zero(di));
-  using M = Mask<D>;
