-// ------------------------------ Reverse (Shuffle0123, Shuffle2301)
-
-// Single lane: no change
-template <class D, typename T = TFromD<D>, HWY_IF_LANES_D(D, 1)>
-HWY_API Vec128<T, 1> Reverse(D /* tag */, Vec128<T, 1> v) {
-  return v;
-}
