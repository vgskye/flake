-            data = open(ext_file, 'r').read() 
-            data = remove_links_to_index(data)
-            data = remove_links_to_index2(data)
-            data = rewrite_md_links(data)
-            handler.write(data)
-            # Open a file for writing
-            # with open('tmp.txt', 'w') as f:
