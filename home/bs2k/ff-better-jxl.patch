-// ------------------------------ Xor
-
-template <typename T>
-HWY_API Vec256<T> Xor(Vec256<T> a, Vec256<T> b) {
-  const DFromV<decltype(a)> d;  // for float16_t
-  const RebindToUnsigned<decltype(d)> du;
-  return BitCast(d, VFromD<decltype(du)>{_mm256_xor_si256(BitCast(du, a).raw,
