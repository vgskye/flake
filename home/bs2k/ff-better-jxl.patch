-template <typename T, HWY_IF_T_SIZE(T, 1)>
-HWY_INLINE Mask256<T> UnmaskedNot(const Mask256<T> m) {
-#if HWY_COMPILER_HAS_MASK_INTRINSICS
-  return Mask256<T>{static_cast<__mmask32>(_knot_mask32(m.raw))};
-#else
