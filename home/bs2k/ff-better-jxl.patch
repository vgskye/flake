-// Evaluates to the function pointer for the chosen target.
-#define HWY_DYNAMIC_POINTER(FUNC_NAME) \
-  (HWY_DISPATCH_TABLE(FUNC_NAME)[hwy::GetChosenTarget().GetIndex()])
