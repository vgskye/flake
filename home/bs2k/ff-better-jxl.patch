-  const char* ptr = uname_buf.release;
-  if (!ptr) {
-    return false;
-  }
-
-  uint32_t major;
-  uint32_t minor;
-  if (!ParseU32(ptr, major)) {
-    return false;
-  }
-
-  if (*ptr != '.') {
-    return false;
-  }
-
-  ++ptr;
-  if (!ParseU32(ptr, minor)) {
-    return false;
-  }
