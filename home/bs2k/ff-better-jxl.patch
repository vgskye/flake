-template <class V, HWY_IF_T_SIZE_V(V, 2)>
-HWY_INLINE V Per64BitBlkRevLanesOnBe(V v) {
-  const DFromV<decltype(v)> d;
-  return Reverse4(d, v);
-}
-template <class V, HWY_IF_T_SIZE_V(V, 4)>
-HWY_INLINE V Per64BitBlkRevLanesOnBe(V v) {
-  const DFromV<decltype(v)> d;
-  return Reverse2(d, v);
