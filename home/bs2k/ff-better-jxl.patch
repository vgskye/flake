-// ------------------------------ LoadExpand
-
-template <class D>
-HWY_API VFromD<D> LoadExpand(MFromD<D> mask, D d,
-                             const TFromD<D>* HWY_RESTRICT unaligned) {
-  size_t in_pos = 0;
-  VFromD<D> ret;
-  for (size_t i = 0; i < Lanes(d); ++i) {
-    if (mask.bits[i]) {
-      ret.raw[i] = unaligned[in_pos++];
-    } else {
-      ret.raw[i] = TFromD<D>();  // zero, also works for float16_t
-    }
-  }
-  return ret;
-}
