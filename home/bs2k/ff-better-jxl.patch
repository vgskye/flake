-  // For lane i, shift the i-th 4-bit index down to bits [0, 2).
-  const Vec256<uint64_t> packed = Set(du, packed_array[mask_bits]);
-  alignas(32) constexpr uint64_t shifts[8] = {0, 4, 8, 12, 16, 20, 24, 28};
