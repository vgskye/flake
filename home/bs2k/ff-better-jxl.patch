-template <size_t kOrigLaneSize, class V,
-          HWY_IF_T_SIZE_ONE_OF_V(V,
-                                 (HWY_HAVE_FLOAT16 ? (1 << 1) : 0) | (1 << 2)),
-          HWY_IF_V_SIZE_GT_V(V, HWY_MAX_BYTES / 2)>
