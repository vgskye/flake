-HWY_API Vec512<T> Broadcast(const Vec512<T> v) {
-  static_assert(0 <= kLane && kLane < 2, "Invalid lane");
-  constexpr _MM_PERM_ENUM perm = kLane ? _MM_PERM_DCDC : _MM_PERM_BABA;
-  return Vec512<T>{_mm512_shuffle_epi32(v.raw, perm)};
-}
