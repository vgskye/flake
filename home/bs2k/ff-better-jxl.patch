-#if HWY_HAVE_FLOAT64
-template <class D, HWY_IF_F64_D(D)>
-HWY_API VFromD<D> PromoteTo(D df64, VFromD<Rebind<float16_t, D>> v) {
-  return PromoteTo(df64, PromoteTo(Rebind<float, D>(), v));
-}
