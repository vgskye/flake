-// NEON lacks popcount for lane sizes > 1, so take pairwise sums of the bytes.
-template <typename T>
-HWY_INLINE Vec128<T> PopulationCount(hwy::SizeTag<2> /* tag */, Vec128<T> v) {
-  const Full128<uint8_t> d8;
