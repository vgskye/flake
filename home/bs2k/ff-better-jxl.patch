-// Not floating-point
-template <typename T>
-HWY_INLINE Vec256<T> Neg(hwy::SignedTag /*tag*/, const Vec256<T> v) {
-  const DFromV<decltype(v)> d;
-  return Zero(d) - v;
-}
-
