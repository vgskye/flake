-// Rotate right 32 bits
-template <typename T>
-HWY_API Vec128<T> Shuffle0321(Vec128<T> v) {
-  Vec128<T> ret;
-  ret.raw[3] = v.raw[0];
-  ret.raw[2] = v.raw[3];
-  ret.raw[1] = v.raw[2];
-  ret.raw[0] = v.raw[1];
