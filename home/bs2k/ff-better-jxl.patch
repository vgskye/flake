-// 3) For tests: include all attainable targets (in particular: scalar)
-#elif (defined(HWY_COMPILE_ALL_ATTAINABLE) || defined(HWY_IS_TEST)) && \
-    !defined(HWY_SKIP_NON_BEST_BASELINE)
-#define HWY_TARGETS HWY_ATTAINABLE_TARGETS
