-  const Repartition<uint16_t, DFromV<decltype(v)>> d;
-  const auto v1 = BitCast(d, v);
-  const auto v2 = detail::ConcatEven(v1, v1);
-  const auto v3 = detail::ConcatEven(v2, v2);
-  return LowerHalf(LowerHalf(v3));
-}
