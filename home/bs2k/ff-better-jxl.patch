-#if HWY_ENABLE_MONITORX
-  kMonitorX = 1,  // AMD
-#endif
-#if HWY_ENABLE_UMONITOR
-  kUMonitor = 2,  // Intel
-#endif
-  kPause = 3,
-  kSentinel  // for iterating over all enumerators. Must be last.
