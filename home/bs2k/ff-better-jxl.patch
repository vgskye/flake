-  const auto shl_amt = And(BitCast(du, Neg(BitCast(di, b))), shift_amt_mask);
-
-  const auto vu = BitCast(du, a);
-  return BitCast(d, Or(Shl(vu, shl_amt), Shr(vu, shr_amt)));
-}
