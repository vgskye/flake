-template <class D>
-HWY_API MFromD<D> FirstN(D d, size_t n) {
-  MFromD<D> m;
-  for (size_t i = 0; i < MaxLanes(d); ++i) {
-    m.bits[i] = MFromD<D>::FromBool(i < n);
-  }
-  return m;
-}
