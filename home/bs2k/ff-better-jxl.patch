-  Vec128<T, N> ret;
-  for (size_t i = 0; i < N; ++i) {
-    if (!mask.bits[i]) {
-      ret.raw[count++] = v.raw[i];
-    }
-  }
-  for (size_t i = 0; i < N; ++i) {
-    if (mask.bits[i]) {
-      ret.raw[count++] = v.raw[i];
-    }
-  }
-  HWY_DASSERT(count == N);
