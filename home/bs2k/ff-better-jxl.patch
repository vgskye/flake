-template <class D>
-HWY_API VFromD<D> Reverse(D d, VFromD<D> v) {
-  VFromD<D> ret;
-  for (size_t i = 0; i < MaxLanes(d); ++i) {
-    ret.raw[i] = v.raw[MaxLanes(d) - 1 - i];
-  }
