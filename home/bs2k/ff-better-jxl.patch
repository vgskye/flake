-// 32-bit x2: shuffle
-template <class D, typename T = TFromD<D>, HWY_IF_T_SIZE(T, 4)>
-HWY_API Vec64<T> Reverse(D /* tag */, Vec64<T> v) {
-  return Vec64<T>{Shuffle2301(Vec128<T>{v.raw}).raw};
-}
