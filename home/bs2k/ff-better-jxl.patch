-HWY_API Vec512<uint8_t> AESLastRoundInv(Vec512<uint8_t> state,
-                                        Vec512<uint8_t> round_key) {
-#if HWY_TARGET <= HWY_AVX3_DL
-  return Vec512<uint8_t>{_mm512_aesdeclast_epi128(state.raw, round_key.raw)};
-#else
