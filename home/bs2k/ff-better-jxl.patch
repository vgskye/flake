-template <class D>
-HWY_API VFromD<D> Undefined(D /*tag*/) {
-#if HWY_HAS_BUILTIN(__builtin_nondeterministic_value)
-  return VFromD<D>{__builtin_nondeterministic_value(Zero(D()).raw)};
