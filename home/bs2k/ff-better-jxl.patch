-    const intptr_t pos = FindFirstTrue(d, And(func(d, v), mask));
-    if (pos >= 0) return i + static_cast<size_t>(pos);
-#endif  // HWY_MEM_OPS_MIGHT_FAULT
-  }
-
-  return count;  // not found
-}
