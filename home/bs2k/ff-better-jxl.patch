-           HWY_RVV_V(BASE, SEW, LMUL) v) {                                  \
-    return __riscv_v##OP##_v_##CHAR##SEW##LMUL##_##CHAR##SEW##LMULD(        \
-        v); /* no AVL */                                                    \
