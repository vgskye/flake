-                                     T c6, T c7, T c8) {
-  T x2 = Mul(x, x);
-  T x4 = Mul(x2, x2);
-  T x8 = Mul(x4, x4);
-  return MulAdd(x8, c8,
-                MulAdd(x4, MulAdd(x2, MulAdd(c7, x, c6), MulAdd(c5, x, c4)),
-                       MulAdd(x2, MulAdd(c3, x, c2), MulAdd(c1, x, c0))));
