-template <typename T, size_t N>
-HWY_API Vec128<T, N> operator<<(Vec128<T, N> v, Vec128<T, N> bits) {
-  for (size_t i = 0; i < N; ++i) {
-    const auto shifted = static_cast<hwy::MakeUnsigned<T>>(v.raw[i])
-                         << bits.raw[i];
-    v.raw[i] = static_cast<T>(shifted);
-  }
-  return v;
