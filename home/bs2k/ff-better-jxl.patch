-  func = AtomicAbortFunc().load();
-  return func;
-}
-
-HWY_DLLEXPORT WarnFunc SetWarnFunc(WarnFunc func) {
-  return AtomicWarnFunc().exchange(func);
-}
-
-HWY_DLLEXPORT AbortFunc SetAbortFunc(AbortFunc func) {
-  return AtomicAbortFunc().exchange(func);
-}
