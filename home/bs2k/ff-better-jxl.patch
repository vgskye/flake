+        // For kAlphaWeightedAdd modes: Co = Cb + Cs * As
+        fn expected_alpha_weighted_add(c_bg: f32, c_fg: f32, fg_a: f32) -> f32 {
+            c_bg + c_fg * fg_a
+        }
+
+        // For kMul mode: Co = Cb * Cs
+        fn expected_mul_blend(c_bg: f32, c_fg: f32) -> f32 {
+            c_bg * c_fg
+        }
