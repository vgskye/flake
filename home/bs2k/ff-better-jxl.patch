-template <class T>
-struct alignas(8) Vec64ValsWrapper {
-  static_assert(sizeof(T) >= 1, "sizeof(T) >= 1 must be true");
-  static_assert(sizeof(T) <= 8, "sizeof(T) <= 8 must be true");
-  T vals[8 / sizeof(T)];
-};
-
-#pragma pack(pop)
