-          HWY_IF_T_SIZE(FromT, sizeof(TFromD<D>) * 2), HWY_IF_LANES_GT_D(D, 1)>
-HWY_API VFromD<D> TruncateTo(D /* d */,
-                             Vec128<FromT, Rebind<FromT, D>().MaxLanes()> v) {
