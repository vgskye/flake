-// 32-bit x4: shuffle
-template <class D, HWY_IF_V_SIZE_D(D, 16), HWY_IF_T_SIZE_D(D, 4)>
-HWY_API VFromD<D> Reverse(D /* tag */, const VFromD<D> v) {
