-#define HWY_NATIVE_U32_SATURATED_ADDSUB
-#endif
-
-template <class V, HWY_IF_U32_D(DFromV<V>)>
-HWY_API V SaturatedAdd(V a, V b) {
-  return Add(a, Min(b, Not(a)));
-}
