-      const uint32_t prev, const std::atomic<uint32_t>& watched) const {
-    for (uint32_t reps = 0;; ++reps) {
-      const uint32_t current = watched.load(std::memory_order_acquire);
-      if (current != prev) return SpinResult{current, reps};
-      hwy::Pause();
-    }
