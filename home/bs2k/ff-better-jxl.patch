-template <typename T, size_t N, HWY_IF_NOT_FLOAT_NOR_SPECIAL(T),
-          HWY_IF_T_SIZE_ONE_OF(T, (1 << 1) | (1 << 2) | (1 << 4))>
-HWY_API Vec128<T, N> SaturatedAdd(Vec128<T, N> a, Vec128<T, N> b) {
-  return Vec128<T, N>{vec_adds(a.raw, b.raw)};
-}
