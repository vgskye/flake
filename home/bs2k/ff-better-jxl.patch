-  const DFromV<decltype(v)> d;
-  const RebindToUnsigned<decltype(d)> du;
-  const MFromD<decltype(du)> mu = RebindMask(du, mask);
-  return BitCast(d, detail::NativeExpand(BitCast(du, v), mu));
