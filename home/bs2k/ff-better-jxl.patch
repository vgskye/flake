-template <class D, HWY_RVV_IF_EMULATED_D(D)>
-HWY_API void StoreN(size_t count, VFromD<D> v, D d, TFromD<D>* HWY_RESTRICT p) {
-  const RebindToUnsigned<decltype(d)> du;
-  StoreN(count, BitCast(du, v), du, detail::U16LanePointer(p));
