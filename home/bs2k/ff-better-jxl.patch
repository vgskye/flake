-      BitCast(du32, DemoteInRangeTo(di32, clamped_lo31_f64));
-  const auto clamped_u32_msb = ShiftLeft<31>(
-      TruncateTo(du32, BitCast(du64, VecFromMask(df64, v_is_ge_k2_31))));
-  return Or(clamped_lo31_u32, clamped_u32_msb);
