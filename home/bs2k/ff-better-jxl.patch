+    fn compare_scalar_simd(scalar: f32, simd: f32, max_abs: f32, max_rel: f32) {
+        let abs = (simd - scalar).abs();
+        let max = simd.abs().max(scalar.abs());
+        let rel = abs / max;
+        assert!(
+            abs < max_abs || rel < max_rel,
+            "simd {simd}, scalar {scalar}, abs {abs:?} rel {rel:?}",
+        );
+    }
