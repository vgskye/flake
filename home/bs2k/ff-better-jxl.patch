-template <class DTo, typename TTo = TFromD<DTo>, typename TFrom,
-          HWY_IF_UNSIGNED(TFrom), HWY_IF_UNSIGNED(TTo),
-          hwy::EnableIf<(sizeof(TTo) < sizeof(TFrom))>* = nullptr>
-HWY_API Vec128<TTo, 1> TruncateTo(DTo /* tag */, Vec128<TFrom, 1> v) {
