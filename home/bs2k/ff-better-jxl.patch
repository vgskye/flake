-  for (uint32_t size = 1; size < kMaxSize; ++size) {
-    const Divisor64 divisor(size);
-
-    const uint32_t coprime = ShuffledIota::FindAnotherCoprime(size, 1);
-    const ShuffledIota shuffled(coprime);
-
-    for (uint32_t start = 0; start < size; ++start) {
