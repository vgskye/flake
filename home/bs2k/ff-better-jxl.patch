-    }
-  }
-
-  size_t Count() const {
-    size_t total = 0;
-    for (const BitSet64& bits : bits_) {
-      total += bits.Count();
-    }
-    return total;
-  }
-
- private:
-  static constexpr size_t kNum64 = DivCeil(kMaxSize, size_t{64});
-  BitSet64 bits_[kNum64];
-};
