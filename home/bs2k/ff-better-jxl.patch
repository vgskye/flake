-// ------------------------------ BroadcastSignBit
-
-template <typename T, size_t N, HWY_IF_SIGNED(T)>
-HWY_API Vec128<T, N> BroadcastSignBit(const Vec128<T, N> v) {
-  return ShiftRight<sizeof(T) * 8 - 1>(v);
