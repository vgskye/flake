-// Rotate left 32 bits
-template <typename T>
-HWY_API Vec128<T> Shuffle2103(Vec128<T> v) {
-  Vec128<T> ret;
-  ret.raw[3] = v.raw[2];
-  ret.raw[2] = v.raw[1];
-  ret.raw[1] = v.raw[0];
-  ret.raw[0] = v.raw[3];
-  return ret;
