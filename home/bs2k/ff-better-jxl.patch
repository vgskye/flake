-// ------------------------------ SaturatedAdd/SaturatedSub for UI32/UI64
-
-#if (defined(HWY_NATIVE_I32_SATURATED_ADDSUB) == defined(HWY_TARGET_TOGGLE))
-#ifdef HWY_NATIVE_I32_SATURATED_ADDSUB
-#undef HWY_NATIVE_I32_SATURATED_ADDSUB
