-// ------------------------------ FirstN (Iota, Lt)
-
-template <class D>
-HWY_API MFromD<D> FirstN(D d, size_t num) {
-  const RebindToUnsigned<decltype(d)> du;
-  using TU = TFromD<decltype(du)>;
-  return RebindMask(d, Iota(du, 0) < Set(du, static_cast<TU>(num)));
-}
