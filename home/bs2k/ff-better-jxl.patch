-template <size_t kLaneIdx, class T, hwy::EnableIf<kLaneIdx != 0>* = nullptr,
-          HWY_IF_NOT_T_SIZE(T, 8)>
-HWY_INLINE Vec256<T> BroadcastLane(hwy::SizeTag<kLaneIdx> /* lane_idx_tag */,
-                                   Vec256<T> v) {
-  constexpr size_t kLanesPerBlock = 16 / sizeof(T);
