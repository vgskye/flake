-void HeapPartialSort(Traits st, T* HWY_RESTRICT lanes, const size_t num_lanes,
-                     const size_t k_lanes) {
-  HeapSelect(st, lanes, num_lanes, k_lanes);
-  HeapSort(st, lanes, k_lanes);
-}
