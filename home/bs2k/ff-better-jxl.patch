-HWY_EXPORT_AND_TEST_P(SkeletonTest, TestAllFloorLog2);
-HWY_EXPORT_AND_TEST_P(SkeletonTest, TestAllSumMulAdd);
-HWY_AFTER_TEST();
-}  // namespace
-}  // namespace skeleton
-HWY_TEST_MAIN();
-#endif  // HWY_ONCE
