-  const Repartition<uint8_t, decltype(d)> du8;
-  const auto idx =
-      Iota(du8, static_cast<uint8_t>(size_t{0} - amt * sizeof(TFromV<V>)));
-  return BitCast(d, TableLookupBytesOr0(BitCast(du8, v), idx));
