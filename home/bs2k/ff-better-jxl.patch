-  const uint8x16_t org_v = detail::BitCastToByte(v).raw;
-  const uint8x16_t w = vuzp1q_u8(org_v, org_v);
-  return Vec32<uint8_t>(vget_low_u8(vuzp1q_u8(w, w)));
