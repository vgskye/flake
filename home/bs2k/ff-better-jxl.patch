-        HWY_ASSERT_EQ(sentinel, pa[i]);
-      }
-      HWY_ASSERT_EQ(sentinel, a[count]);
-
-      ReplaceIf(d, pb.get(), count, new_t, IfEq<T>(old_t));
-      HWY_ASSERT_ARRAY_EQ(expected.get(), pb.get(), count);
-      // Ensure no out-of-bound writes.
