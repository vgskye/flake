-HWY_API void Stream(VFromD<D> v, D d, TFromD<D>* HWY_RESTRICT aligned) {
-  const RebindToUnsigned<decltype(d)> du;  // for float16_t
-  _mm_stream_si128(reinterpret_cast<__m128i*>(aligned), BitCast(du, v).raw);
-}
