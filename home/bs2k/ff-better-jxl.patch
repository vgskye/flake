-// ------------------------------ InsertBlock
-#ifdef HWY_NATIVE_BLK_INSERT_EXTRACT
-#undef HWY_NATIVE_BLK_INSERT_EXTRACT
-#else
-#define HWY_NATIVE_BLK_INSERT_EXTRACT
-#endif
