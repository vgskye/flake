-template <size_t N>
-HWY_API Vec128<uint64_t, N> Min(Vec128<uint64_t, N> a, Vec128<uint64_t, N> b) {
-#if HWY_ARCH_ARM_A64
-  return IfThenElse(b < a, b, a);
-#else
-  const DFromV<decltype(a)> du;
-  const RebindToSigned<decltype(du)> di;
