-// ------------------------------ ExtractLane
-template <typename T>
-HWY_API T ExtractLane(const Vec256<T> v, size_t i) {
-  alignas(32) T lanes[32 / sizeof(T)];
-  Store(v, DFromV<decltype(v)>(), lanes);
-  return lanes[i];
-}
-
-// ------------------------------ InsertLane
-template <typename T>
-HWY_API Vec256<T> InsertLane(const Vec256<T> v, size_t i, T t) {
-  DFromV<decltype(v)> d;
-  alignas(32) T lanes[32 / sizeof(T)];
-  Store(v, d, lanes);
-  lanes[i] = t;
-  return Load(d, lanes);
-}
