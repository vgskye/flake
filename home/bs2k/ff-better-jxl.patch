-HWY_INLINE uint64_t* GetGeneratorStateStatic() {
-  thread_local uint64_t state[3] = {0};
-  // This is a counter; zero indicates not yet initialized.
-  if (HWY_UNLIKELY(state[2] == 0)) {
-    Fill16BytesStatic(state);
-    state[2] = 1;
-  }
-  return state;
-}
