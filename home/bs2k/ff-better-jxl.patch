-template <class D, HWY_IF_V_SIZE_LE_D(D, 16), class V>
-HWY_INLINE VFromD<D> ReorderDemote2From64To32Combine(D dn, V a, V b) {
-  return ConcatEven(dn, BitCast(dn, b), BitCast(dn, a));
-}
