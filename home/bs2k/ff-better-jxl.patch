-  template <size_t N, int kPow2>                                             \
-  HWY_API HWY_SVE_V(BASE, BITS)                                              \
-      NAME(HWY_SVE_D(BASE, BITS, N, kPow2) dw, HWY_SVE_V(BASE, HALF) a,      \
-           HWY_SVE_V(BASE, HALF) b, HWY_SVE_V(BASE, BITS) sum) {             \
