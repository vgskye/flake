-HWY_API VFromD<D> Truncate2To(
-    D /* tag */, Vec128<FromT, Repartition<FromT, D>().MaxLanes()> lo,
-    Vec128<FromT, Repartition<FromT, D>().MaxLanes()> hi) {
-  return VFromD<D>{vec_pack(lo.raw, hi.raw)};
