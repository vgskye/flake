-#if HWY_TARGET <= HWY_AVX3
-  return Vec256<uint64_t>{_mm256_ror_epi64(v.raw, kBits)};
-#else
-  if (kBits == 0) return v;
-  return Or(ShiftRight<kBits>(v), ShiftLeft<HWY_MIN(63, 64 - kBits)>(v));
-#endif
-}
