-template <class D, HWY_IF_V_SIZE_LE_D(D, 16)>
-HWY_API VFromD<D> ZeroExtendVector(D d, VFromD<Half<D>> lo) {
-  const Half<D> dh;
-  return IfThenElseZero(FirstN(d, MaxLanes(dh)), VFromD<D>{lo.raw});
-}
