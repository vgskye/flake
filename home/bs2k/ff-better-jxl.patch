-
-#if HWY_TARGET <= HWY_SSE4
-#ifdef HWY_NATIVE_SUMS_OF_ADJ_QUAD_ABS_DIFF
-#undef HWY_NATIVE_SUMS_OF_ADJ_QUAD_ABS_DIFF
