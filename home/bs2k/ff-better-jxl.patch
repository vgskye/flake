-template <size_t N>
-void MeasureDiv(const FuncInput (&inputs)[N]) {
-  printf("Measuring integer division (output on final two lines)\n");
-  Result results[N];
-  Params params;
-  params.max_evals = kMaxEvals;
-  const size_t num_results = Measure(&Div, nullptr, inputs, N, results, params);
