+    }
+
+    pub fn process(
+        mut self,
+        input: &mut impl JxlBitstreamInput,
+    ) -> Result<ProcessingResult<JxlDecoder<WithFrameInfo>, Self>> {
+        let inner_result = self.inner.process(input, None)?;
+        Ok(self.map_inner_processing_result(inner_result))
+    }
