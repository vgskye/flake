-template <class V, HWY_IF_UNSIGNED_V(V),
-          HWY_IF_T_SIZE_ONE_OF_V(V, (1 << 1) | (1 << 2))>
-HWY_INLINE V NormalizeForUIntTruncConvToF32(V v) {
-  return v;
