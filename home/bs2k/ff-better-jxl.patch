-template <class D, HWY_IF_V_SIZE_LE_D(D, 4), HWY_IF_I8_D(D)>
-HWY_API VFromD<D> DemoteTo(D /* tag */, VFromD<Rebind<int32_t, D>> v) {
-  const __m128i i16 = _mm_packs_epi32(v.raw, v.raw);
-  return VFromD<D>{_mm_packs_epi16(i16, i16)};
-}
