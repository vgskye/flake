-// ------------------------------ InsertBlock
-template <int kBlockIdx, class T>
-HWY_API Vec256<T> InsertBlock(Vec256<T> v, Vec128<T> blk_to_insert) {
-  static_assert(kBlockIdx == 0 || kBlockIdx == 1, "Invalid block index");
-  Vec256<T> result;
-  if (kBlockIdx == 0) {
-    result.v0 = blk_to_insert;
-    result.v1 = v.v1;
-  } else {
-    result.v0 = v.v0;
-    result.v1 = blk_to_insert;
-  }
-  return result;
-}
