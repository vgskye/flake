-
-  Image3(ImageT&& plane0, ImageT&& plane1, ImageT&& plane2) {
-    if (!SameSize(plane0, plane1) || !SameSize(plane0, plane2)) {
-      HWY_ABORT(
-          "Not same size: %d x %d, %d x %d, %d x %d\n",
