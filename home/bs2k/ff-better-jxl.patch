-  const vuint8mf8_t eqHx = detail::AndS(eqHL, 0xaa);
-  const vuint8mf8_t eqxL = ShiftRight<1>(eqHx);
-  auto du8m1 = ScalableTag<uint8_t>{};
-  return detail::U8MaskBitsVecToMask(d,
-                                     detail::ChangeLMUL(du8m1, Or(eqHx, eqxL)));
