-template <class V, HWY_IF_NOT_T_SIZE_V(V, 1)>
-HWY_INLINE V CompressBits(V v, const uint8_t* HWY_RESTRICT bits) {
-  return Compress(v, LoadMaskBits(DFromV<V>(), bits));
-}
