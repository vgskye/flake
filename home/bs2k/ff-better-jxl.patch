-template <typename T>
-HWY_INLINE Mask256<T> Not(hwy::SizeTag<1> /*tag*/, const Mask256<T> m) {
-  // sizeof(T) == 1: simply return ~m as all 32 bits of m are valid
-  return UnmaskedNot(m);
