-template <typename T>
-HWY_API Vec1<T> Not(const Vec1<T> v) {
-  using TU = MakeUnsigned<T>;
-  const Sisd<TU> du;
-  return BitCast(Sisd<T>(), Vec1<TU>(static_cast<TU>(~BitCast(du, v).raw)));
-}
