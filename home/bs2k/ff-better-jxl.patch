+        for x in samples {
+            let a = x.abs();
+            *x = if a <= 0.0031308 {
+                a * 12.92
+            } else {
+                a.powf(1.0 / 2.4).mul_add(1.055, -0.055)
+            }
+            .copysign(*x);
+        }
+    }
