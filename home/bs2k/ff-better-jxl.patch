-template <class D, HWY_IF_V_SIZE_LE_D(D, 16), typename TI>
-HWY_API Indices128<TFromD<D>, HWY_MAX_LANES_D(D)> SetTableIndices(
-    D d, const TI* idx) {
-  static_assert(sizeof(TFromD<D>) == sizeof(TI), "Index size must match lane");
