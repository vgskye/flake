-    return me()->Func(idx, x, y);
-  }
-
-  X_VEC X0Init() { return me()->X0InitImpl(); }
-
-  X_VEC X0InitImpl() { return hn::Zero(d_in); }
-
-  Y_VEC YInit() { return me()->YInitImpl(); }
-
-  Y_VEC YInitImpl() { return hn::Zero(d_out); }
