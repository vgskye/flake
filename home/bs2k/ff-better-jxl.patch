-template <class D64, HWY_IF_UI64_D(D64)>
-HWY_API VFromD<D64> PromoteInRangeTo(D64 d64, VFromD<Rebind<float, D64>> v) {
-  VFromD<D64> ret;
-  for (size_t i = 0; i < MaxLanes(d64); ++i) {
-    ret.raw[i] = detail::CastValueForInRangeF2IConv<TFromD<D64>>(v.raw[i]);
-  }
-  return ret;
-}
