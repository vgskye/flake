-template <class D, HWY_IF_NOT_T_SIZE_D(D, 1)>
-HWY_API VFromD<D> Reverse4(D d, const VFromD<D> v) {
-  const RebindToUnsigned<D> du;
-  const auto idx = detail::XorS(detail::Iota0(du), 3);
