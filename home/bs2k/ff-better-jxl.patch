-}
-
-template <typename D, HWY_IF_V_SIZE_D(D, 32), HWY_IF_T_SIZE_D(D, 4)>
-HWY_API VFromD<D> Slide1Down(D d, VFromD<D> v) {
-#if HWY_TARGET <= HWY_AVX3
-  return detail::CombineShiftRightI32Lanes<1>(Zero(d), v);
-#else
