-  using VU = VFromD<decltype(du)>;
-#if HWY_S390X_HAVE_Z14
-  return BitCast(d, VU{BitCast(du, a).raw | BitCast(du, b).raw});
-#else
-  return BitCast(d, VU{vec_or(BitCast(du, a).raw, BitCast(du, b).raw)});
-#endif
-}
