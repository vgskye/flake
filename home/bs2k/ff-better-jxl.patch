-  // On targets other than Armv7 NEON, use F16 or F32 division as most targets
-  // other than Armv7 NEON have native F32 divide instructions
-  return ConvertInRangeTo(d, Div(ConvertTo(df, a), ConvertTo(df, b)));
-#endif
