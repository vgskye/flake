-template <typename T, size_t N, HWY_IF_FLOAT3264(T)>
-HWY_API Vec128<T, N> Neg(Vec128<T, N> v) {
-#if HWY_S390X_HAVE_Z14
-  return Xor(v, SignBit(DFromV<decltype(v)>()));
-#else
-  return Vec128<T, N>{vec_neg(v.raw)};
-#endif
-}
