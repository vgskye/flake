-#if HWY_TARGET == HWY_SSE4
-  const Vec32<uint32_t> bits32{_mm_cvtepu32_epi64(bits.raw)};
-#else
-  const auto bits32 =
-      Combine(Full64<uint32_t>(), Zero(Full32<uint32_t>()), bits);
-#endif
-  return Vec128<uint32_t, 1>{_mm_srl_epi32(in.raw, bits32.raw)};
-}
-#endif
