-// ------------------------------ BroadcastSignBit
-template <typename T, size_t N>
-HWY_API Vec128<T, N> BroadcastSignBit(Vec128<T, N> v) {
-  for (size_t i = 0; i < N; ++i) {
-    v.raw[i] = ScalarShr(v.raw[i], sizeof(T) * 8 - 1);
-  }
-  return v;
