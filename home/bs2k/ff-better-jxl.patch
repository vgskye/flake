-template <typename T, size_t N>
-HWY_API Vec128<T, N> InterleaveLower(Vec128<T, N> a, Vec128<T, N> b) {
-  Vec128<T, N> ret;
-  for (size_t i = 0; i < N / 2; ++i) {
-    ret.raw[2 * i + 0] = a.raw[i];
-    ret.raw[2 * i + 1] = b.raw[i];
-  }
