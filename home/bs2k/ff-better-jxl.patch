-HWY_API Vec128<T, N> And(const Vec128<T, N> a, const Vec128<T, N> b) {
-  const DFromV<decltype(a)> d;
-  const RebindToUnsigned<decltype(d)> du;
-  return BitCast(d, BitCast(du, a) & BitCast(du, b));
-}
