-// Emulated version for Armv7.
-template <typename T, HWY_IF_T_SIZE(T, 8)>
-HWY_API Vec128<T> InterleaveLower(Vec128<T> a, Vec128<T> b) {
-  const DFromV<decltype(a)> d;
-  return CombineShiftRightBytes<8>(d, b, Shuffle01(a));
-}
-#endif
