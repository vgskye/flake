-template <int kLane, class T, HWY_IF_T_SIZE(T, 1)>
-HWY_API Vec512<T> Broadcast(const Vec512<T> v) {
-  static_assert(0 <= kLane && kLane < 16, "Invalid lane");
-  return TableLookupBytes(v, Set(Full512<T>(), static_cast<T>(kLane)));
-}
