+const DELTA_LIMIT: i64 = 1 << 30;
+const SPLINE_POS_LIMIT: isize = 1 << 23;
+
+const QUANTIZATION_ADJUSTMENT_CONTEXT: usize = 0;
+const STARTING_POSITION_CONTEXT: usize = 1;
