-HWY_API Vec32<int32_t> RearrangeToOddPlusEven(Vec32<int32_t> sum0,
-                                              Vec32<int32_t> sum1) {
-  // Only one widened sum per register, so add them for sum of odd and even.
-  return sum0 + sum1;
