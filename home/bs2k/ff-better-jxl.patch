+    Dct16x32,
+    Dct4x8,
+    // Dct8x4
+    Afv0,
+    // Afv1
+    // Afv2
+    // Afv3
+    Dct64x64,
+    // Dct64x32,
+    Dct32x64,
+    Dct128x128,
+    // Dct128x64,
+    Dct64x128,
+    Dct256x256,
+    // Dct256x128,
+    Dct128x256,
+}
+
+impl QuantTable {
+    pub const CARDINALITY: usize = Self::VALUES.len();
+    pub const VALUES: [QuantTable; 17] = [
