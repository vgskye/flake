+    for i in 0..column_chunks {
+        for j in 0..row_chunks {
+            D::F32Vec::transpose_square(d, &mut data[j * 8 + i..], column_chunks);
+        }
+        do_idct_4(d, &mut data[i..], column_chunks);
+    }
