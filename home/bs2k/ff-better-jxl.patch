-      count = static_cast<size_t>(rng()) % (16 * N + 1);
-    }
-    counts[0] = 0;  // ensure we test count=0.
-
-    for (size_t count : counts) {
-      for (size_t m : misalignments) {
-        Test()(d, count, m, rng);
-      }
