++		if (data.has_raw_angular_velocity) {
++			relation.relation_flags |= XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT;
++			relation.angular_velocity = data.raw_angular_velocity;
++		}
++		if (data.has_linear_acceleration) {
